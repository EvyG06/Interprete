let x = "global";

// Una variable local con el mismo nombre oculta la global
let local = function() {
    let x = "local";
    return x;
};
print("dentro:", local(), "fuera:", x);

// Un parámetro también oculta la global
let parametro = function(x) {
    x = "parámetro modificado";
    return x;
};
print("dentro:", parametro("arg"), "fuera:", x);

// Sin let, = modifica la variable global
let contador = 0;
let incrementar = function() {
    contador = contador + 1;
};
incrementar();
incrementar();
print("contador global:", contador);

// Alcance léxico: f ve la x de donde se definió, no la de quien la llama
let f = function() { x };
let g = function() {
    let x = "de g";
    return f();
};
print("alcance léxico:", g());

// Closure: n sobrevive entre llamadas
let crearContador = function() {
    let n = 0;
    return function() {
        n = n + 1;
        return n;
    };
};
let c = crearContador();
c();
c();
print("closure:", c());
