// while
let n = 5;
let factorial = 1;
while (n > 1) {
    factorial = factorial * n;
    n = n - 1;
}
print("5! =", factorial);

// for con las tres partes
let suma = 0;
for (let i = 1; i <= 10; i = i + 1) {
    suma = suma + i;
}
print("suma de 1 a 10 =", suma);

// recorrer una lista
let numeros = [4, 8, 15, 16, 23, 42];
let mayor = numeros[0];
for (let j = 1; j < len(numeros); j = j + 1) {
    if (numeros[j] > mayor) {
        mayor = numeros[j];
    }
}
print("mayor de la lista =", mayor);
